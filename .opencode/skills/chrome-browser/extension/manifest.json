{
  "manifest_version": 3,
  "name": "Chrome Browser Bridge",
  "version": "2.3.0",
  "minimum_chrome_version": "125",
  "description": "Local, selected-tab browser control for the OpenCode chrome-browser skill",
  "key": "",
  "permissions": [
    "activeTab",
    "cookies",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Chrome Browser Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
